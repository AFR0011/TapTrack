{
  "name": "TapTrack",
  "short_name": "TapTrack",
  "description": "Local-first personal finance tracking for daily income and expenses.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/icons/taptrack-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/taptrack-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Record an expense with Quick Add.",
      "url": "/app/add?type=expense&mode=quick"
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Record income with Quick Add.",
      "url": "/app/add?type=income&mode=quick"
    },
    {
      "name": "Command entry",
      "short_name": "Command",
      "description": "Open TapTrack's keyboard-first transaction entry.",
      "url": "/app/add?mode=command"
    }
  ]
}
