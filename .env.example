# Supabase Auth + optional finance-data sync
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Privileged server-only Supabase access used by integration paths.
# Never expose this value to browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token
TAPTRACK_OWNER_TELEGRAM_CHAT_ID=your-telegram-chat-id
TAPTRACK_OWNER_USER_ID=supabase-user-id

# Optional local/controlled AI categorization endpoint (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
